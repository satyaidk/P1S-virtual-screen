# By default the app shows YOUR printer: sign in on the console (http://localhost:3000).
# Credentials are handled by this app's own server and stored in .data/ (git-ignored).

# The printer this app is built for (defaults are in src/server/printer-config.ts).
# BAMBU_PRINTER_SERIAL=01P00C662003044
# BAMBU_PRINTER_NAME=Bambu Lab P1S
# Fixed IP address; skips automatic network discovery (e.g. when the router blocks broadcasts).
# BAMBU_PRINTER_HOST=192.168.1.50

# Where the server keeps the Bambu session + chosen printer (default: ./.data)
# P1S_DATA_DIR=.data

# Allow other devices on your network (phone, tablet, Raspberry Pi screen) to use the console
# and display. Off by default because these routes can control the printer.
# P1S_ALLOW_LAN_CLIENTS=1

# Development only: always use the built-in simulator (same as opening /?demo=1)
# NEXT_PUBLIC_PRINTER_MODE=simulation

# Hosted deployments (Vercel) — REQUIRED there. Encrypts the per-browser Bambu sign-in cookie.
# Any random text of 32+ characters, e.g. the output of: openssl rand -base64 32
# Set it in Vercel → Project → Settings → Environment Variables, then redeploy.
# P1S_SESSION_SECRET=

# Force hosted (cloud-only) behaviour locally, e.g. to test it: P1S_HOSTED=1

# Frontend (public, non-secret). Default mode is the built-in simulator.
NEXT_PUBLIC_PRINTER_MODE=simulation
# NEXT_PUBLIC_PRINTER_MODE=lan-bridge
# NEXT_PUBLIC_BRIDGE_URL=ws://127.0.0.1:8787/v1/stream


# By default the app shows YOUR printer: sign in on the console (http://localhost:3000).
# Credentials are handled by this app's own server and stored in .data/ (git-ignored).

# Where the server keeps the Bambu session + chosen printer (default: ./.data)
# P1S_DATA_DIR=.data

# Allow other devices on your network (phone, tablet, Raspberry Pi screen) to use the console
# and display. Off by default because these routes can control the printer.
# P1S_ALLOW_LAN_CLIENTS=1

# Development only: always use the built-in simulator (same as opening /?demo=1)
# NEXT_PUBLIC_PRINTER_MODE=simulation
